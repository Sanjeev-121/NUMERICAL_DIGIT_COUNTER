"""
problem:how many times the given unit digit present in the given range
"""
print("To determine that how many times a unit digit appered between the given range")
T=int(input("Upto which number you want to determine: "))
number = int(input("Enter the digit: "))
count=0
for i in range(1,T+1):
    temp=i
    while (temp!=0):
        rem=temp%10
        temp=temp//10
        if (rem==number):
            count+=1

print("Total Numbers of times the digit",number,"present in 1 to",T,"is",count)
print("thank you for visiting")